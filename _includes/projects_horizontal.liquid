<div class="col mb-3">
  <a class="project-row" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    {% if project.img %}
      <div class="project-row-thumb">
        <img src="{{ project.img | relative_url }}" alt="" loading="lazy">
      </div>
    {% endif %}
    <div class="project-row-body">
      {% if project.context or project.period %}
        <p class="project-row-meta">
          {{ project.context -}}
          {%- if project.context and project.period %} · {% endif -%}
          {{- project.period }}
        </p>
      {% endif %}
      <h3 class="project-row-title">
        {{ project.title }}
        <i class="fa-solid fa-arrow-right"></i>
      </h3>
      <p class="project-row-desc">{{ project.description }}</p>
      {% if project.highlight %}
        <p class="project-row-highlight">{{ project.highlight }}</p>
      {% endif %}
      {% if project.tags %}
        <p class="project-row-tags">
          {% for tag in project.tags %}
            <span class="project-tag">{{ tag }}</span>
          {% endfor %}
        </p>
      {% endif %}
    </div>
  </a>
</div>
